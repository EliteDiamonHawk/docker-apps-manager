<Window x:Class="DockApps.Manager.LogsWindow"
        Title="Compose Logs"
        Width="900"
        Height="620"
        MinWidth="560"
        MinHeight="360"
        Background="#101828"
        WindowStartupLocation="CenterOwner"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <DockPanel Grid.Row="0" Margin="0,0,0,10">
            <Button DockPanel.Dock="Right" Content="Refresh" Click="RefreshClick" Padding="13,6"/>
            <TextBlock x:Name="TitleText" Foreground="White" FontSize="17" FontWeight="SemiBold" VerticalAlignment="Center"/>
        </DockPanel>
        <TextBox x:Name="LogsTextBox" Grid.Row="1" IsReadOnly="True" AcceptsReturn="True" TextWrapping="NoWrap" FontFamily="Consolas" FontSize="12" Foreground="#D0D5DD" Background="#1D2939" BorderBrush="#344054" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" Padding="10"/>
        <TextBlock x:Name="StatusText" Grid.Row="2" Margin="0,9,0,0" Foreground="#98A2B3" TextWrapping="Wrap"/>
    </Grid>
</Window>
