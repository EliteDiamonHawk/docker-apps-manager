<Window x:Class="DockApps.Manager.ManagerWindow"
        Title="DockApps Manager"
        Width="980"
        Height="700"
        MinWidth="760"
        MinHeight="500"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterScreen"
        Background="#F7F8FA"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <DockPanel Margin="22">
        <StackPanel DockPanel.Dock="Top">
            <TextBlock Text="DockApps" FontSize="28" FontWeight="SemiBold" Foreground="#172033"/>
            <TextBlock Text="Docker application manager" Margin="0,2,0,16" Foreground="#667085"/>
            <Border Padding="14" CornerRadius="8" Background="White" BorderBrush="#D0D5DD" BorderThickness="1">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Ellipse x:Name="DockerStatusIndicator" Width="12" Height="12" Margin="0,2,10,0" Fill="#98A2B3"/>
                    <StackPanel Grid.Column="1">
                        <TextBlock x:Name="DockerStatus" FontSize="15" FontWeight="SemiBold" Foreground="#172033"/>
                        <TextBlock x:Name="DockerOwnershipStatus" Margin="0,3,0,0" Foreground="#667085" TextWrapping="Wrap"/>
                    </StackPanel>
                </Grid>
            </Border>
            <TextBlock x:Name="ValidationMessage" Margin="0,10,0,0" Foreground="#B42318" TextWrapping="Wrap"/>
        </StackPanel>

        <StackPanel DockPanel.Dock="Bottom" Margin="0,16,0,0">
            <TextBlock x:Name="StatusMessage" Margin="0,0,0,10" Foreground="#475467" TextWrapping="Wrap"/>
            <WrapPanel HorizontalAlignment="Right">
                <Button x:Name="RefreshButton" Content="Refresh" Click="RefreshClick" Padding="14,7" Margin="0,0,8,0"/>
                <Button x:Name="RegisterButton" Content="Register App" Click="RegisterClick" Padding="14,7" Margin="0,0,8,0"/>
                <Button x:Name="EditButton" Content="Edit Selected" Click="EditClick" Padding="14,7" Margin="0,0,8,0"/>
                <Button x:Name="RemoveButton" Content="Remove Selected" Click="RemoveClick" Padding="14,7" Margin="0,0,8,0"/>
                <Button x:Name="ShortcutButton" Content="Start Menu Shortcut" Click="ShortcutClick" Padding="14,7" Margin="0,0,8,0"/>
                <Button x:Name="DesktopShortcutButton" Content="Desktop Shortcut" Click="DesktopShortcutClick" Padding="14,7" Margin="0,0,8,0"/>
                <Button x:Name="ManagerShortcutButton" Content="Manager Shortcut" Click="ManagerShortcutClick" Padding="14,7" Margin="0,0,8,0"/>
                <Button x:Name="SoftStopButton" Content="Soft Stop" Click="SoftStopClick" Padding="14,7" Margin="0,0,8,0"/>
                <Button x:Name="HardStopButton" Content="Hard Stop" Click="HardStopClick" Padding="14,7"/>
            </WrapPanel>
        </StackPanel>

        <Grid Margin="0,16,0,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="145"/>
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0" Text="Registered applications" FontSize="17" FontWeight="SemiBold" Foreground="#172033" Margin="0,0,0,8"/>
            <ListView x:Name="AppsList" Grid.Row="1" SelectionChanged="AppsSelectionChanged" MouseDoubleClick="AppDoubleClick" Background="White" BorderBrush="#D0D5DD" BorderThickness="1">
                <ListView.View>
                    <GridView>
                        <GridViewColumn Header="Name" DisplayMemberBinding="{Binding Name}" Width="190"/>
                        <GridViewColumn Header="ID" DisplayMemberBinding="{Binding Id}" Width="130"/>
                        <GridViewColumn Header="Status" DisplayMemberBinding="{Binding State}" Width="105"/>
                        <GridViewColumn Header="Services" DisplayMemberBinding="{Binding Services}" Width="75"/>
                        <GridViewColumn Header="Project" DisplayMemberBinding="{Binding ProjectName}" Width="150"/>
                        <GridViewColumn Header="URL" DisplayMemberBinding="{Binding Url}" Width="230"/>
                    </GridView>
                </ListView.View>
            </ListView>

            <TextBlock Grid.Row="2" Text="Unregistered or external containers" FontSize="17" FontWeight="SemiBold" Foreground="#172033" Margin="0,16,0,8"/>
            <ListView x:Name="ContainersList" Grid.Row="3" Background="White" BorderBrush="#D0D5DD" BorderThickness="1">
                <ListView.View>
                    <GridView>
                        <GridViewColumn Header="Name" DisplayMemberBinding="{Binding Name}" Width="220"/>
                        <GridViewColumn Header="State" DisplayMemberBinding="{Binding State}" Width="110"/>
                        <GridViewColumn Header="Health" DisplayMemberBinding="{Binding Health}" Width="100"/>
                        <GridViewColumn Header="Compose project" DisplayMemberBinding="{Binding Project}" Width="190"/>
                        <GridViewColumn Header="Image" DisplayMemberBinding="{Binding Image}" Width="270"/>
                    </GridView>
                </ListView.View>
            </ListView>
        </Grid>
    </DockPanel>
</Window>
